includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
includeConfig "${projectDir}/config/profiles.config"


def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    input_csv = "${projectDir}/test/test_integration_MSFragger_TMT_Protein/input.csv"
    channel_csv = "${projectDir}/test/test_integration_MSFragger_TMT_Protein/channel.csv"
    dataset_id = 'ecoli_tmt'

    msfragger_executable = "${TEST_DATA_DIR}/MSFragger-4.4.1.jar"

    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    decoy_position = 'prefix'
    contam_string = 'contam_'
    contam_position = 'prefix'

    experiment_type = 'TMT'

    run_proteovault = false

    search_ProteomicMSMS {
        license = 'yes'
        search_engines = ['MSFragger']
        MSFraggerAdapter {
            license = 'yes'
            tolerance {
                precursor_mass_tolerance_lower = 20.0
                precursor_mass_tolerance_upper = 20.0
                precursor_mass_unit = 'ppm'
                fragment_mass_tolerance = 0.03
                fragment_mass_unit = 'Da'
            }
            digest {
                search_enzyme_name = 'Trypsin'
                allowed_missed_cleavage = '3'
                num_enzyme_termini = 'fully'
            }
            statmod {
                add_C_cysteine = 57.021464
                add_K_lysine = 229.162932
                add_nterm_peptide = 229.162932
            }
            varmod {
                masses = []
                syntaxes = []
                unimod = ['Oxidation (M)', 'Deamidated (N)', 'Deamidated (Q)']
            }
            PeptideIndexing {
                decoy_string = 'rev_'
                decoy_string_position = 'prefix'
                unmatched_action = 'remove'
            }
        }
    }

    quantitate_ProteomicTMT {
        plex_type = 'tmt10plex'
        tmt_normalization_method = 'mad'
        tmt_workflow = 'feature_based'
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test_integration_MSFragger_TMT_Protein', launchDir
)

methods.setup()

process {
    echo = false
    debug = false
}
