includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
includeConfig "${projectDir}/config/profiles.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    compute_profile = System.getenv('NFT_CLUSTER') == 'pines' ? 'pines' : 'boutroslab_aws'
    input_csv = "${projectDir}/test/test_integration_Sage_LFQ_Protein/input.csv"

    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    decoy_position = 'prefix'
    contam_string = 'contam_'
    contam_position = 'prefix'

    experiment_type = 'LFQ'

    search_ProteomicMSMS {
        search_engines = ['Sage']
        SageAdapter {
            decoy_prefix = 'rev_'
            precursor_tol_left = -20.0
            precursor_tol_right = 20.0
            precursor_tol_unit = 'ppm'
            fragment_tol_left = -50.0
            fragment_tol_right = 50.0
            fragment_tol_unit = 'ppm'
            missed_cleavages = 1
            fixed_modifications = ['Carbamidomethyl (C)']
            variable_modifications = []
            q_value_threshold = 1.0
            PeptideIndexing {
                decoy_string = 'rev_'
                decoy_string_position = 'prefix'
                unmatched_action = 'remove'
            }
        }
    }

    quantitate_ProteomicLFQ {
        algorithm = 'FFId'
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test_integration_Sage_LFQ_Protein', launchDir
)

methods.setup()

process {
    echo = false
    debug = false
}
