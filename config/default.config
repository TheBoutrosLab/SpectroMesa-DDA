params {
    input_csv = null
    decoy_database = null
    msfragger_executable = ''
    output_dir = null
    dataset_id = 'cohort'
    experiment_type = 'LFQ'
    channel_csv = ''
    child_profile = 'standard'
    run_proteovault = true
    proteovault_version = '0.2.3'
    docker_image_proteovault = "ghcr.io/theboutroslab/proteovault:${params.proteovault_version}"
    compute_profile = ''
    additional_resource_profile_dir = ''
    decoy_string = 'DECOY_'
    decoy_position = 'prefix'
    contam_string = 'CONTAMINANT_'
    contam_position = 'prefix'
    ucla_cds = false
    convert_MSData {
        convert_algorithm = 'ProteoWizard'
        output_format = 'mzML'
        peak_picking_vendor = true
        peak_picking_openms = false
        run_index = true
        pwiz_extra_args = '--64'
    }
    search_ProteomicMSMS {
        search_engines = ['MSFragger']
        reindex_mzml = false
        export_mzTab = false
        export_all_psms = true
        CometAdapter {
            PeptideIndexing {
                decoy_string = 'DECOY_'
                decoy_string_position = 'prefix'
                unmatched_action = 'remove'
            }
        }
        SageAdapter {
            decoy_prefix = 'DECOY_'
            PeptideIndexing {
                decoy_string = 'DECOY_'
                decoy_string_position = 'prefix'
                unmatched_action = 'remove'
            }
        }
        MSFraggerAdapter {
            PeptideIndexing {
                decoy_string = 'DECOY_'
                decoy_string_position = 'prefix'
                unmatched_action = 'remove'
            }
        }
    }
    validate_ProteomicPSM {
        run_percolator = true
        percolator_workflow = 'openms'
        run_protloom = false
        protloom_project_yaml = ''
        merge_consensus = false
    }
    quantitate_ProteomicTMT {
        plex_type = 'tmt10plex'
        consensusXML_entrypoint = false
        tmt_workflow = 'scan_based'
    }
    quantitate_ProteomicLFQ {
        algorithm = 'FFId'
    }
    quantitate_ProteomicProtein {
        protein_grouping_algorithm = 'ProteinProphet'
        protein_fdr_cutoff = 0.01
    }
    qc_ProteomicDDA {
        pyopenms_version = '3.5.0'
    }
}
process.executor = 'local'
docker.enabled = true
docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in \$(id -G); do echo -n \"--group-add=\$i \"; done)"
apptainer.enabled = false
singularity.enabled = false
