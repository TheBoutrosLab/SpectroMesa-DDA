includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"

methods {
    validate_inputs = {
        ['input_csv', 'decoy_database', 'output_dir'].each { name ->
            if (!params[name]) throw new IllegalArgumentException("Required parameter --${name} is missing")
        }
        ['input_csv', 'decoy_database'].each { name ->
            if (!new File(params[name].toString()).isFile()) {
                throw new IllegalArgumentException("--${name} must be an existing file")
            }
        }
        if (!(params.experiment_type in ['TMT', 'LFQ'])) {
            throw new IllegalArgumentException('experiment_type must be TMT or LFQ')
        }
        if (params.convert_MSData.output_format != 'mzML') {
            throw new IllegalArgumentException('DDA conversion requires convert_MSData.output_format = mzML')
        }
        if (params.experiment_type == 'TMT' &&
            (!params.channel_csv || !new File(params.channel_csv.toString()).isFile())) {
            throw new IllegalArgumentException('TMT requires an existing --channel_csv')
        }
        def engines = params.search_ProteomicMSMS.search_engines
        if (!(engines instanceof List) || !engines || engines.toSet().size() != engines.size() ||
            !engines.every { it in ['Comet', 'Sage', 'MSFragger'] }) {
            throw new IllegalArgumentException('search_engines must be a nonempty list of unique Comet, Sage, or MSFragger engines')
        }
        if ('MSFragger' in engines &&
            (!params.msfragger_executable || !new File(params.msfragger_executable.toString()).isFile() ||
             new File(params.msfragger_executable.toString()).name == 'NO_FILE')) {
            throw new IllegalArgumentException('MSFragger requires an existing --msfragger_executable')
        }
        if (params.validate_ProteomicPSM.run_protloom &&
            !new File(params.validate_ProteomicPSM.protloom_project_yaml.toString()).isFile()) {
            throw new IllegalArgumentException('run_protloom requires an existing protloom_project_yaml')
        }
        if (params.quantitate_ProteomicProtein.protein_grouping_algorithm == 'ProteinProphet' &&
            !params.validate_ProteomicPSM.run_percolator) {
            throw new IllegalArgumentException('ProteinProphet needs Percolator PEP scored idXML')
        }
    }
    apply_compute_profile = {
        if (!params.compute_profile) return
        def name = params.compute_profile.toString()
        if (!(name ==~ /[A-Za-z0-9_]+/)) {
            throw new IllegalArgumentException("Invalid compute profile: ${name}")
        }
        def dirs = []
        if (params.additional_resource_profile_dir) {
            params.additional_resource_profile_dir.toString()
                .split(java.util.regex.Pattern.quote(File.pathSeparator))
                .findAll { it?.trim() }
                .each { entry ->
                    def dir = new File(entry)
                    dirs << (dir.isAbsolute() ? dir : new File(launchDir.toString(), entry)).canonicalFile
                }
        }
        dirs << new File("${projectDir}/config/resource_profiles")
        def source = dirs.collect { new File(it, "${name}.json") }.find { it.isFile() }
        if (!source) throw new IllegalArgumentException("Unknown compute profile: ${name}")
        def profile = new groovy.json.JsonSlurper().parse(source)
        if (!(profile instanceof Map) || !(profile.max_cpus instanceof Number) ||
            profile.max_cpus < 1 ||
            !(profile.max_memory?.toString() ==~ /(?i)^\d+(?:\.\d+)?\s*GB$/) ||
            !(profile.children instanceof Map)) {
            throw new IllegalArgumentException("Invalid compute profile: ${source}")
        }
        params.max_cpus = profile.max_cpus
        params.max_memory = profile.max_memory
        def childDirectories = [
            convert_MSData: 'convert-MSData',
            search_ProteomicMSMS: 'search-ProteomicMSMS',
            validate_ProteomicPSM: 'validate-ProteomicPSM',
            quantitate_ProteomicTMT: 'quantitate-ProteomicTMT',
            quantitate_ProteomicLFQ: 'quantitate-ProteomicLFQ',
            quantitate_ProteomicProtein: 'quantitate-ProteomicProtein',
            qc_ProteomicDDA: 'qc-ProteomicDDA'
        ]
        if (profile.children.keySet() != childDirectories.keySet()) {
            throw new IllegalArgumentException("Compute profile ${name} must define the DDA child pipelines")
        }
        def gigabytes = { value ->
            def match = (value.toString() =~ /(?i)^(\d+(?:\.\d+)?)\s*GB$/)
            if (!match.matches()) {
                throw new IllegalArgumentException("Resource memory must be expressed in GB: ${value}")
            }
            new BigDecimal(match[0][1])
        }
        childDirectories.each { child, directory ->
            params[child].max_cpus = profile.max_cpus
            params[child].max_memory = profile.max_memory
            def requested = profile.children[child]
            def defaults = new groovy.json.JsonSlurper().parse(
                new File("${projectDir}/external/${directory}/config/resources.json")
            ).default
            if (!(requested instanceof Map) || requested.keySet() != defaults.keySet()) {
                throw new IllegalArgumentException(
                    "Compute profile ${name} must define every process in ${directory}"
                )
            }
            def updates = [cpus: [], memory: []]
            defaults.each { processName, allocation ->
                def target = requested[processName]
                if (!(target instanceof Map) || !(target.cpus instanceof Number) ||
                    target.cpus != target.cpus.intValue() ||
                    !target.containsKey('memory')) {
                    throw new IllegalArgumentException(
                        "Compute profile ${name} requires CPU and memory requests for ${directory}:${processName}"
                    )
                }
                def targetCpus = target.cpus as int
                def targetMemory = gigabytes(target.memory)
                if (targetCpus < allocation.cpus.min || targetCpus > profile.max_cpus ||
                    targetCpus > allocation.cpus.max ||
                    targetMemory < gigabytes(allocation.memory.min) ||
                    targetMemory > gigabytes(profile.max_memory) ||
                    targetMemory > gigabytes(allocation.memory.max)) {
                    throw new IllegalArgumentException(
                        "Invalid ${name} resources for ${directory}:${processName}"
                    )
                }
                def cpuSpec = allocation.cpus
                def baseCpus = Math.max(cpuSpec.min as int,
                    Math.min(cpuSpec.max as int, (int)(profile.max_cpus * cpuSpec.fraction)))
                def memorySpec = allocation.memory
                def baseMemory = [gigabytes(memorySpec.min),
                    [gigabytes(memorySpec.max),
                     gigabytes(profile.max_memory) * memorySpec.fraction].min()].max()
                if (!params[child].base_resource_update) {
                    // Nextflow truncates fractional CPUs and memory bytes.
                    // Round multipliers up so requests resolve to the intended units.
                    if (targetCpus != baseCpus) {
                        def factor = (targetCpus as BigDecimal).divide(
                            baseCpus as BigDecimal, 20, java.math.RoundingMode.CEILING)
                        updates.cpus << [processName,
                            factor == factor.intValue() ? factor.intValue() : factor]
                    }
                    if (targetMemory != baseMemory) {
                        updates.memory << [processName,
                            targetMemory.divide(baseMemory, 20, java.math.RoundingMode.CEILING)]
                    }
                }
            }
            if (!params[child].base_resource_update) {
                params[child].base_resource_update = updates.findAll { resource, entries -> entries }
            }
        }
    }
    set_child_params = {
        if ('MSFragger' in params.search_ProteomicMSMS.search_engines && params.decoy_position != 'prefix') {
            throw new IllegalArgumentException('MSFragger requires prefix decoys')
        }
        if (params.search_ProteomicMSMS.search_engines.size() > 1) {
            params.validate_ProteomicPSM.merge_consensus = true
        }
        params.search_ProteomicMSMS.decoy_database = params.decoy_database
        params.search_ProteomicMSMS.msfragger_executable = params.msfragger_executable
        ['Comet', 'Sage', 'MSFragger'].each { engine ->
            params.search_ProteomicMSMS["${engine}Adapter"].PeptideIndexing.decoy_string = params.decoy_string
            params.search_ProteomicMSMS["${engine}Adapter"].PeptideIndexing.decoy_string_position = params.decoy_position
        }
        params.search_ProteomicMSMS.SageAdapter.decoy_prefix = params.decoy_string
        params.validate_ProteomicPSM.decoy_database = params.decoy_database
        params.validate_ProteomicPSM.decoy_string = params.decoy_string
        params.validate_ProteomicPSM.decoy_string_position = params.decoy_position
        params.quantitate_ProteomicProtein.decoy_database = params.decoy_database
        params.quantitate_ProteomicProtein.decoy_string = params.decoy_string
    }
    set_output_and_log_dir = {
        params.metapipeline_output_dir = "${params.output_dir}/${manifest.name}-${manifest.version}"
        params.output_dir_base = "${params.output_dir}/${manifest.name}-${manifest.version}/${params.dataset_id}"
        def date = new Date().format("yyyyMMdd'T'HHmmss'Z'", TimeZone.getTimeZone('UTC'))
        params.log_output_dir = "${params.output_dir_base}/log-${manifest.name}-${manifest.version}-${date}"
        params.final_output_dir = "${params.output_dir_base}/main_workflow"
    }
    setup = {
        methods.validate_inputs()
        // Interpolation of the default image precedes user version overrides.
        if (params.docker_image_proteovault == 'ghcr.io/theboutroslab/proteovault:0.2.4') {
            params.docker_image_proteovault =
                "ghcr.io/theboutroslab/proteovault:${params.proteovault_version}"
        }
        def runtime = params.child_profile?.toString()
        def matchingRuntime = (runtime in ['standard', 'docker'] && docker.enabled) ||
            (runtime == 'apptainer' && apptainer.enabled) ||
            (runtime == 'singularity' && singularity.enabled) ||
            (runtime == 'local' && !docker.enabled && !apptainer.enabled && !singularity.enabled)
        if (!matchingRuntime) {
            throw new IllegalArgumentException(
                "Select the matching parent container profile with -profile ${runtime}"
            )
        }
        methods.apply_compute_profile()
        methods.set_child_params()
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_output_and_log_dir()
        trace.enabled = true
        trace.file = "${params.log_output_dir}/nextflow-log/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.log_output_dir}/nextflow-log/timeline.html"
        report.enabled = true
        report.file = "${params.log_output_dir}/nextflow-log/report.html"
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params,
            new File("${params.log_output_dir}/nextflow-log/params.json"))
    }
}
