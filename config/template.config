includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
includeConfig "${projectDir}/config/profiles.config"
params {
    input_csv = '/path/to/mzML.csv'
    decoy_database = '/path/to/target-decoy.fasta'
    msfragger_executable = '/path/to/MSFragger.jar' // Required only when MSFragger is selected.
    output_dir = '/path/to/results'
    dataset_id = 'cohort'
    experiment_type = 'LFQ'  // or TMT
    channel_csv = ''         // required for TMT
    child_profile = 'standard'
    // proteovault_version = '0.2.0'
    convert_MSData {
        convert_algorithm = 'ProteoWizard'
        output_format = 'mzML'
    }
    search_ProteomicMSMS {
        search_engines = ['MSFragger'] // Any nonempty subset of Comet, Sage, MSFragger.
    }
    quantitate_ProteomicTMT {
        plex_type = 'tmt10plex'
    }
}
methods.setup()
